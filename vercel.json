{
  "crons": [
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/post-purchase-emails",
      "schedule": "0 9 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "atelier-lbf.fr"
        }
      ],
      "destination": "https://www.atelier-lbf.fr/:path",
      "permanent": true
    }
  ]
}
